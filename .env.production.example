# TITAN production environment template — PLACEHOLDERS ONLY.
# Copy to a secrets manager / host env. Do NOT commit real values.
# Do NOT overwrite apps/api/.env with this file.

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
TITAN_ENV=production
APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SEED_DEV=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=replace-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-secret
INTEGRATIONS_ENCRYPTION_KEY=replace-with-32-plus-char-random-secret

# ── Supabase (optional metadata; DB URL above is authoritative) ─
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # store only in secrets manager if required

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:PASSWORD@redis-host:6379/0
READY_REQUIRE_REDIS=true

# ── Storage ──────────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=titan-aura-prod
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
COMPANY_MEDIA_STORAGE_PATH=/var/lib/titan/storage/company-media
JOB_EVIDENCE_STORAGE_PATH=/var/lib/titan/storage/job-evidence

# ── Runtime / feature gates (production-safe defaults) ───────
PROVIDERS_ENABLED=false
WEBHOOKS_ENABLED=false
AUTOMATIONS_ENABLED=false
SCHEDULERS_ENABLED=false
WORKERS_ENABLED=false
OUTBOUND_MESSAGES_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
XERO_SYNC_ENABLED=false
WHATSAPP_ENABLED=false
EMAIL_SENDING_ENABLED=false

# ── Email (disabled until EMAIL_SENDING_ENABLED=true) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── WhatsApp (disabled) ──────────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Xero (disabled) ──────────────────────────────────────────
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://api.example.com/api/v1/integrations/xero/oauth/callback

# ── Payments / Yoco (disabled) ───────────────────────────────
# YOCO_PUBLIC_KEY=
# YOCO_SECRET_KEY=

# ── Cartrack (disabled) ──────────────────────────────────────
# CARTRACK_API_KEY=
# CARTRACK_BASE_URL=

# ── Google / Maps / Calendar (disabled) ─────────────────────
# GOOGLE_MAPS_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Meta (disabled) ──────────────────────────────────────────
# META_APP_ID=
# META_APP_SECRET=

# ── n8n (loopback/staging only until authorized) ─────────────
# N8N_BASE_URL=http://127.0.0.1:5678
# N8N_WEBHOOK_SECRET=

# ── AURA / AI (disabled until PROVIDERS_ENABLED=true) ────────
AURA_DEFAULT_PROVIDER=openai
AURA_OPENAI_API_KEY=
AURA_OPENAI_MODEL=gpt-4o-mini
AURA_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Observability (optional; do not activate externally yet) ─
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
