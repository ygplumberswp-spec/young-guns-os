{
  "name": "@titan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx src/index.ts",
    "start:worker": "node --import tsx src/bin/worker.ts",
    "start:scheduler": "node --import tsx src/bin/scheduler.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/lib/tenant-scope.test.ts src/lib/n8n-signing.test.ts src/lib/env-flags.test.ts src/lib/storage-paths.test.ts src/lib/auth-cookies.test.ts src/services/*.test.ts src/services/jobs-contract.test.ts"
  },
  "dependencies": {
    "@titan/aura": "workspace:*",
    "@titan/auth": "workspace:*",
    "@titan/db": "workspace:*",
    "@titan/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "pino": "catalog:",
    "pino-http": "^10.4.0",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
