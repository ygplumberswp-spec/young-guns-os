# TITAN API — multi-stage production image (providers gated off by default)
FROM node:20-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate
WORKDIR /app

FROM base AS deps
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
COPY packages/auth/package.json packages/auth/
COPY packages/db/package.json packages/db/
COPY packages/aura/package.json packages/aura/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter @titan/api...

FROM base AS build
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter @titan/shared --filter @titan/auth --filter @titan/db --filter @titan/aura --filter @titan/api run build

FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
# Railway injects PORT at runtime — do not hardcode listen port here.
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# Persistent storage defaults — mount a Railway volume at /var/lib/titan/storage.
ENV COMPANY_MEDIA_STORAGE_PATH=/var/lib/titan/storage/company-media
ENV JOB_EVIDENCE_STORAGE_PATH=/var/lib/titan/storage/job-evidence
# System Chromium for finance PDF rendering (no download on container start).
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    fonts-liberation \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable && corepack prepare pnpm@10.12.1 --activate \
  && groupadd --system titan && useradd --system --gid titan --create-home titan \
  && mkdir -p \
       /var/lib/titan/storage/company-media \
       /var/lib/titan/storage/job-evidence \
       /var/titan/company-media \
       /var/titan/job-evidence \
       /var/titan/staging/company-media \
       /var/titan/staging/job-evidence \
  && chown -R titan:titan /var/lib/titan /var/titan
WORKDIR /app

COPY --from=build --chown=titan:titan /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build --chown=titan:titan /app/apps/api /app/apps/api
COPY --from=build --chown=titan:titan /app/packages /app/packages
COPY --from=build --chown=titan:titan /app/node_modules /app/node_modules

# Runtime uses tsx + TypeScript sources because workspace packages emit
# extensionless ESM imports (moduleResolution bundler) that Node cannot load from dist.
USER titan
# Documentary default; runtime bind uses process.env.PORT from Railway.
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
WORKDIR /app/apps/api
CMD ["node", "--import", "tsx", "src/index.ts"]
