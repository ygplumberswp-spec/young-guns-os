# Variable NAMES and non-secret staging defaults for titan-staging-api.
# Enter secret values only in Railway Variables UI — never commit secrets.
# NEVER set production DATABASE_URL (forbidden live project ref).

# --- Required non-secret ---
NODE_ENV=production
APP_ENV=staging
TITAN_ENV=staging
HOST=0.0.0.0
PORT=3000
SEED_DEV=false
LOG_LEVEL=info
READY_REQUIRE_REDIS=false

# --- Placeholders until public/private URLs approved (do not enable public networking yet) ---
# APP_URL=<staging-web-origin-later>
# API_PUBLIC_URL=<staging-api-origin-later>

# --- Secrets (set in Railway; generate ≥32 chars; do not paste here) ---
# DATABASE_URL=<STAGING ONLY>
# JWT_SECRET=<generate>
# JWT_REFRESH_SECRET=<generate>
# INTEGRATIONS_ENCRYPTION_KEY=<generate>
# COMPANY_MEDIA_STORAGE_PATH=/var/titan/staging/company-media
# JOB_EVIDENCE_STORAGE_PATH=/var/titan/staging/job-evidence

# --- Gates MUST remain disabled ---
PROVIDERS_ENABLED=false
WEBHOOKS_ENABLED=false
AUTOMATIONS_ENABLED=false
SCHEDULERS_ENABLED=false
WORKERS_ENABLED=false
OUTBOUND_MESSAGES_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
XERO_SYNC_ENABLED=false
WHATSAPP_ENABLED=false
EMAIL_SENDING_ENABLED=false

# --- Do not set in this phase ---
# REDIS_URL=
