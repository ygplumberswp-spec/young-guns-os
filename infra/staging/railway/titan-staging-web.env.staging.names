# Build-time / runtime variables for titan-staging-web.
# Docs: https://docs.railway.com/builds/dockerfiles

RAILWAY_DOCKERFILE_PATH=infra/docker/Dockerfile.web

VITE_APP_ENV=staging
VITE_TITAN_ENV=staging
# Prefer empty Vite API base + runtime nginx proxy:
VITE_API_BASE_URL=
# Runtime (WEB service): public API origin, no path — enables same-origin /api proxy
API_PROXY_UPSTREAM=https://young-guns-os-staging.up.railway.app
