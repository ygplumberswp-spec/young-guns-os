# Build-time variables / Docker build args for titan-staging-web.
# Set as Railway Variables with "Available at Build Time" enabled where required.

VITE_APP_ENV=staging
VITE_TITAN_ENV=staging

# Leave empty until API networking/URL is approved (same-origin proxy not used in this image).
# When API private/public URL exists, set:
# VITE_API_BASE_URL=https://<staging-api-host>
VITE_API_BASE_URL=
