{
  "name": "YGOS - Low Stock Auto Purchase Request",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 6 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.YGOS_API_URL}}/api/v1/inventory/low-stock",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-low-stock",
      "name": "Get Low Stock Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "ygos-api-key", "name": "YGOS API Auth" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ $json.data.length }}",
              "rightValue": "0",
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "has-low-stock",
      "name": "Any Low Stock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all()[0].json.data;\n\n// Group by supplier\nconst bySupplier = {};\nfor (const item of items) {\n  const supplierId = item.supplierId || 'no-supplier';\n  if (!bySupplier[supplierId]) {\n    bySupplier[supplierId] = {\n      supplierId,\n      supplierName: item.supplier?.name || 'No Supplier Assigned',\n      items: []\n    };\n  }\n  bySupplier[supplierId].items.push({\n    inventoryId: item.id,\n    sku: item.sku,\n    name: item.name,\n    currentStock: item.stockLevels.reduce((sum, sl) => sum + sl.quantity, 0),\n    reorderQuantity: item.reorderQuantity,\n    unitPrice: item.costPrice\n  });\n}\n\nreturn Object.values(bySupplier).map(group => ({ json: group }));"
      },
      "id": "group-by-supplier",
      "name": "Group By Supplier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.YGOS_API_URL}}/api/v1/purchase-orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "supplierId", "value": "={{ $json.supplierId }}" },
            { "name": "items", "value": "={{ JSON.stringify($json.items.map(i => ({ inventoryId: i.inventoryId, quantity: i.reorderQuantity, unitPrice: Number(i.unitPrice) }))) }}" },
            { "name": "notes", "value": "Auto-generated by low stock workflow" }
          ]
        },
        "options": {}
      },
      "id": "create-po",
      "name": "Create Purchase Order (Draft)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 200],
      "credentials": {
        "httpHeaderAuth": { "id": "ygos-api-key", "name": "YGOS API Auth" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.YGOS_API_URL}}/api/v1/notifications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "LOW_STOCK_PO_CREATED" },
            { "name": "title", "value": "Purchase Order Generated - Low Stock" },
            { "name": "body", "value": "PO created for {{ $json.supplierName }}: {{ $json.items.length }} items below reorder point. Review and approve." },
            { "name": "channel", "value": "IN_APP" }
          ]
        },
        "options": {}
      },
      "id": "notify-warehouse",
      "name": "Notify Warehouse Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 200],
      "credentials": {
        "httpHeaderAuth": { "id": "ygos-api-key", "name": "YGOS API Auth" }
      }
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Get Low Stock Items", "type": "main", "index": 0 }]] },
    "Get Low Stock Items": { "main": [[{ "node": "Any Low Stock?", "type": "main", "index": 0 }]] },
    "Any Low Stock?": { "main": [[{ "node": "Group By Supplier", "type": "main", "index": 0 }], []] },
    "Group By Supplier": { "main": [[{ "node": "Create Purchase Order (Draft)", "type": "main", "index": 0 }]] },
    "Create Purchase Order (Draft)": { "main": [[{ "node": "Notify Warehouse Manager", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "YGOS" }, { "name": "Inventory" }, { "name": "Automation" }]
}
