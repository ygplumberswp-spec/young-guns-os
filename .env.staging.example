# =============================================================================
# TITAN API — Railway staging variables (PLACEHOLDERS ONLY)
# =============================================================================
# Copy into Railway → titan-staging-api → Variables (Raw Editor).
# NEVER use production Supabase / JWT / encryption values here.
# NEVER commit real secrets.
#
# Startup validation source: apps/api/src/config.ts (NODE_ENV=production + APP_ENV=staging)
# =============================================================================

# --- Runtime labels (required for staging behaviour / URL fallbacks) ---
NODE_ENV=production
APP_ENV=staging
TITAN_ENV=staging
SEED_DEV=false
LOG_LEVEL=info

# --- Bind (Railway sets PORT automatically; keep HOST for 0.0.0.0 listen) ---
HOST=0.0.0.0
# PORT is injected by Railway — do not hardcode in Railway if the platform sets it.
# PORT=3000

# --- Public / CORS origins (set once you have Railway domains; optional until then) ---
# If unset with APP_ENV=staging, API falls back to railway.internal placeholders.
APP_URL=https://titan-staging-web.up.railway.app
API_PUBLIC_URL=https://titan-staging-api.up.railway.app

# --- Database (REQUIRED — staging Supabase/Postgres only) ---
# Source: Staging Supabase project → Settings → Database → Connection string (URI)
# Must NOT be the production project.
DATABASE_URL=postgresql://postgres.STAGING_PROJECT_REF:STAGING_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# --- Auth secrets (REQUIRED — generate unique staging values, ≥32 chars each) ---
# Source: generate locally, e.g. openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STAGING_JWT_REFRESH_SECRET_AT_LEAST_32_CHARS

# --- Integrations crypto (REQUIRED when NODE_ENV=production) ---
# Source: generate unique staging key, ≥32 chars (openssl rand -base64 48)
# Used to encrypt stored integration credentials; keep staging-only.
INTEGRATIONS_ENCRYPTION_KEY=REPLACE_WITH_STAGING_INTEGRATIONS_KEY_AT_LEAST_32_CHARS

# --- Redis (optional this phase — leave unset) ---
# REDIS_URL=redis://default:PASSWORD@staging-redis.railway.internal:6379
READY_REQUIRE_REDIS=false

# --- Disk paths inside the container (optional; defaults exist in code) ---
COMPANY_MEDIA_STORAGE_PATH=/var/titan/staging/company-media
JOB_EVIDENCE_STORAGE_PATH=/var/titan/staging/job-evidence

# --- Runtime mode (optional; default api) ---
TITAN_RUNTIME_MODE=api

# --- Provider / worker gates (REQUIRED for safe staging — keep all false) ---
PROVIDERS_ENABLED=false
WEBHOOKS_ENABLED=false
AUTOMATIONS_ENABLED=false
SCHEDULERS_ENABLED=false
WORKERS_ENABLED=false
OUTBOUND_MESSAGES_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
XERO_SYNC_ENABLED=false
WHATSAPP_ENABLED=false
EMAIL_SENDING_ENABLED=false

# --- Provider credentials (optional — DO NOT set while gates are false) ---
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=
# AURA_OPENAI_API_KEY=
# AURA_OPENAI_MODEL=
# AURA_DEFAULT_PROVIDER=

# --- Railway build helper (recommended for Dockerfile builds) ---
RAILWAY_DOCKERFILE_PATH=infra/docker/Dockerfile.api
