# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# API server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://titan:titan@localhost:5432/titan_aura

# Redis (used in later milestones)
REDIS_URL=redis://localhost:6379

# Auth secrets (required — use long random values in production)
JWT_SECRET=dev-jwt-secret-change-before-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-before-production-32chars

# Integration credentials encryption (required to save Cartrack credentials)
INTEGRATIONS_ENCRYPTION_KEY=dev-integrations-encryption-key-32chars
# Tenant Google Maps keys are stored encrypted in integration_connections (not here).
# Optional platform fallback only — prefer Integrations → Google Maps settings UI.
# GOOGLE_MAPS_API_KEY=

# AURA AI provider (server-side only — never expose in frontend)
AURA_DEFAULT_PROVIDER=openai
AURA_OPENAI_API_KEY=
AURA_OPENAI_MODEL=gpt-4o-mini
AURA_OPENAI_BASE_URL=https://api.openai.com/v1
AURA_MAX_HISTORY_MESSAGES=20

# Object storage (not used until Milestone 6)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=titan-aura
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Company logo/profile uploads (local dev — relative to repo root)
COMPANY_MEDIA_STORAGE_PATH=storage/company-media
JOB_EVIDENCE_STORAGE_PATH=storage/job-evidence

# Email (not used until Milestone 6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Business Gmail — official Google OAuth 2.0 (API host only)
# Without these, Communications Hub shows honest "Not configured" (no fake connection).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/communications-platform/gmail/oauth/callback

# Policy: never seed demo data in production
SEED_DEV=false

# Runtime / provider gates (see TITAN_PRODUCTION_ENVIRONMENT_VARIABLES.md)
# Development defaults keep native workers on; providers stay off unless enabled.
PROVIDERS_ENABLED=false
WEBHOOKS_ENABLED=false
OUTBOUND_MESSAGES_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
XERO_SYNC_ENABLED=false
WHATSAPP_ENABLED=false
# Optional Meta App Secret — when set, X-Hub-Signature-256 is enforced on /webhooks/whatsapp
# WHATSAPP_APP_SECRET=
EMAIL_SENDING_ENABLED=false
# WORKERS_ENABLED=true
# SCHEDULERS_ENABLED=true
# AUTOMATIONS_ENABLED=true
# READY_REQUIRE_REDIS=false

